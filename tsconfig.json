{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": { "src/*": ["./*"] },
    "jsx": "react-jsx"
  }
}
